# AI-VRS Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values from "terraform output" or
# from the output printed by scripts/deploy.sh.
#
# IMPORTANT: Never commit .env to version control — it is gitignored.
# This .env.example file is safe to commit (it contains no real values).
# ─────────────────────────────────────────────────────────────────────────────

# API Gateway endpoint URL (from Terraform output: api_gateway_url)
# Example: https://abc123def.execute-api.us-east-1.amazonaws.com/prod
VITE_API_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com/prod

# Cognito User Pool ID (from Terraform output: cognito_user_pool_id)
# Example: us-east-1_AbCdEfGhI
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# Cognito App Client ID (from Terraform output: cognito_client_id)
# Example: 1a2b3c4d5e6f7g8h9i0j1k2l3m
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
