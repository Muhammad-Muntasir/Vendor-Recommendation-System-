    {
      "description": "POST /jobs — Create a new job",
      "request": {
        "method": "POST",
        "path": "/jobs",
        "headers": { "Authorization": "Bearer <access_token>", "Content-Type": "application/json" },
        "body": {
          "type": "plumbing",
          "location": "Austin, TX",
          "urgency": "High",
          "slaDeadline": "2025-07-29T10:00:00Z",
          "description": "Burst pipe in commercial kitchen requiring immediate repair."
        }
      },
      "response": {
        "statusCode": 201,
